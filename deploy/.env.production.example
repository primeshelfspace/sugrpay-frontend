# ---------------------------------------------------------------------------
# Web apps' settings for a deployed site (on Amplify: each app's Environment
# variables; on a server: copy to .env).
#
# The three apps are ONE site on ONE domain:
#   https://<site>/            Sugrpay admin
#   https://<site>/accounts/…  Accounts (sign-in, team, billing)
#   https://<site>/pay/…       public payment pages
# Change the site address in the four *_URL lines below and nowhere else here.
#
# NEXT_PUBLIC_* values are compiled into the apps when they are built, so a
# change only takes effect after the next build/deploy.
# Walkthrough: deploy/README.md
# ---------------------------------------------------------------------------

# --- Ports (only when running on a server behind nginx) ---------------------
ADMIN_PORT=3000
PAYMENT_PORT=3001
ACCOUNTS_PORT=3002

# --- Where everything lives --------------------------------------------------
# Must match the backend's *_PUBLIC_URL settings
# (platform: bash deploy/set-public-urls.sh --site https://<site>).
NEXT_PUBLIC_API_URL=https://api.13-56-132-111.sslip.io
NEXT_PUBLIC_INVOICING_URL=https://app.primeshelfspace.com
NEXT_PUBLIC_ACCOUNTS_URL=https://app.primeshelfspace.com/accounts
NEXT_PUBLIC_PAYMENT_PUBLIC_URL=https://app.primeshelfspace.com/pay
NEXT_PUBLIC_HQ_URL=

# --- Sign-in -----------------------------------------------------------------
# Leave empty: every app is on the same domain, so the sign-in cookie is
# shared without it.
COOKIE_DOMAIN=

# --- Payment page security policy -------------------------------------------
# Brand logos are served from S3 through signed URLs; the payment page's CSP
# blocks them unless the bucket's origin is listed here.
NEXT_PUBLIC_ASSET_ORIGIN=https://invoice-dev-839810213531-us-east-1-an.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_GATEWAY_ORIGIN=
