{
  "name": "sugrpay-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Every Sugrpay web app: Accounts (sign-in, team, billing), the Sugrpay admin app and the public payment pages. Talks to the platform backend over HTTP.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build --env-mode=loose",
    "typecheck": "turbo run typecheck --env-mode=loose",
    "lint": "eslint .",
    "test": "turbo run test --env-mode=loose",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "check:deps": "node scripts/check-deps.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:deps && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.1.3",
    "@types/node": "^22.10.2",
    "eslint": "9.17.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "prettier": "^3.4.2",
    "turbo": "2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.18.1"
  }
}
