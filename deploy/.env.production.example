# ---------------------------------------------------------------------------
# Sugrpay web app settings for a deployed site (on Amplify: the app's
# Environment variables; on a server: copy to .env).
#
# One app, one address:
#   https://<site>/            Sugrpay admin
#   https://<site>/accounts/…  sign-in, sign-up, team, brands, billing
#   https://<site>/pay/…       public payment pages
# To move to a new domain, change <site> in the three *_URL lines below.
#
# NEXT_PUBLIC_* values are compiled into the app when it is built, so a change
# only takes effect after the next build/deploy.
# ---------------------------------------------------------------------------

# Only when running on a server behind nginx (Amplify sets its own).
PORT=3000

# Must match the backend's *_PUBLIC_URL settings
# (platform server: bash deploy/set-public-urls.sh --site https://<site>).
NEXT_PUBLIC_API_URL=https://api.13-56-132-111.sslip.io
NEXT_PUBLIC_INVOICING_URL=https://app.primeshelfspace.com
NEXT_PUBLIC_ACCOUNTS_URL=https://app.primeshelfspace.com/accounts
NEXT_PUBLIC_PAYMENT_PUBLIC_URL=https://app.primeshelfspace.com/pay

# Leave empty: everything is on one address.
COOKIE_DOMAIN=

# Brand logos are served from S3 through signed URLs; the /pay pages' CSP
# blocks them unless the bucket's origin is listed here.
NEXT_PUBLIC_ASSET_ORIGIN=https://invoice-dev-839810213531-us-east-1-an.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_GATEWAY_ORIGIN=
