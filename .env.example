# Sugrpay front end — local settings. Copy to .env and adjust.
#
# The backend lives in its own repository (primeshelfspace/platform). Start it
# first; these apps call it over HTTP at NEXT_PUBLIC_API_URL.

# --- Ports -----------------------------------------------------------------
# Read by each app's dev/start script (see scripts/with-env.mjs).
ADMIN_PORT=3000
PAYMENT_PORT=3001
ACCOUNTS_PORT=3002

# --- Where each app lives --------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is compiled into the client bundle. Never put
# a secret behind this prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3002/accounts
NEXT_PUBLIC_INVOICING_URL=http://localhost:3000
NEXT_PUBLIC_PAYMENT_PUBLIC_URL=http://localhost:3001/pay
# HQ has no web app yet; leave empty until it does.
NEXT_PUBLIC_HQ_URL=

# --- One sign-in across apps ------------------------------------------------
# Every web app shares one session cookie. Leave empty locally (all apps are on
# localhost). In production set the parent domain, e.g. .primeshelfspace.com.
COOKIE_DOMAIN=
# Forces the cookie's Secure flag on/off when no TLS proxy sets
# x-forwarded-proto. Leave unset normally.
# COOKIE_SECURE=true

# --- Payment page security policy -------------------------------------------
# Read by apps/payment/src/middleware.ts to widen the payment app's CSP. The CSP
# is `img-src 'self' data: blob:`, which blocks a brand logo served from a
# bucket — set this to the bucket origin when the backend stores logos in S3,
# e.g. https://your-bucket.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_ASSET_ORIGIN=
# Allows the gateway's hosted tokenization script/iframe origin into that same
# CSP. Empty until there is a real origin to allow.
NEXT_PUBLIC_GATEWAY_ORIGIN=
