# Sugrpay web app — local settings. Copy to .env and adjust.
#
# One app, one address:
#   http://localhost:3000/            Sugrpay admin
#   http://localhost:3000/accounts/…  sign-in, sign-up, team, brands, billing
#   http://localhost:3000/pay/…       public payment pages
#
# The backend lives in its own repository (primeshelfspace/platform). Start it
# first. It is three APIs: this app calls the platform API (sign-in, company,
# team, brands) and the Sugrpay API (invoices, customers, payments), each at its
# own address; src/lib/api-urls.ts picks the right one for every call.

# --- Port ------------------------------------------------------------------
# Read by the app's dev/start script (see scripts/with-env.mjs).
PORT=3000

# --- Where things live -----------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is compiled into the client bundle. Never put
# a secret behind this prefix.
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:4001
NEXT_PUBLIC_SUGRPAY_API_URL=http://localhost:4002
NEXT_PUBLIC_INVOICING_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3000/accounts
NEXT_PUBLIC_PAYMENT_PUBLIC_URL=http://localhost:3000/pay

# --- Sign-in cookie ----------------------------------------------------------
# Leave empty: everything is on one address, so the cookie needs no domain.
COOKIE_DOMAIN=
# Forces the cookie's Secure flag on/off when no TLS proxy sets
# x-forwarded-proto. Leave unset normally.
# COOKIE_SECURE=true

# --- Payment page security policy -------------------------------------------
# Read by src/pay/middleware.ts to widen the /pay pages' CSP. The CSP is
# `img-src 'self' data: blob:`, which blocks a brand logo served from a
# bucket — set this to the bucket origin when the backend stores logos in S3,
# e.g. https://your-bucket.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_ASSET_ORIGIN=
# Allows the gateway's hosted tokenization script/iframe origin into that same
# CSP. Empty until there is a real origin to allow.
NEXT_PUBLIC_GATEWAY_ORIGIN=

# "true" shows New Invoice / Add Customer again (hidden while creating
# records on the website is switched off; see apps/sugrpay/src/lib/features.ts).
NEXT_PUBLIC_ALLOW_CREATE_RECORDS=false
