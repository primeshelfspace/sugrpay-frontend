# ---------------------------------------------------------------------------
# Web apps' environment for a deployed server (staging or production).
#
#   cp deploy/.env.production.example .env
#
# Replace every CHANGE-ME and the host names if your domain is not
# primeshelfspace.com. Each setting is explained in .env.example.
#
# NEXT_PUBLIC_* values are compiled into the apps when they are built, so a
# change here only takes effect after the next `bash deploy/deploy.sh`.
# Walkthrough: deploy/README.md
# ---------------------------------------------------------------------------

# --- Ports (behind nginx; not exposed to the internet) ----------------------
ADMIN_PORT=3000
PAYMENT_PORT=3001
ACCOUNTS_PORT=3002

# --- Where each app lives --------------------------------------------------
# Must match nginx and the backend's *_PUBLIC_URL settings exactly.
NEXT_PUBLIC_API_URL=https://api.primeshelfspace.com
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.primeshelfspace.com
NEXT_PUBLIC_INVOICING_URL=https://sugrpay.primeshelfspace.com
NEXT_PUBLIC_PAYMENT_PUBLIC_URL=https://pay.primeshelfspace.com
NEXT_PUBLIC_HQ_URL=

# --- One sign-in across apps ------------------------------------------------
# The parent domain, with the leading dot, so the session cookie reaches every
# app's subdomain. Secure is set automatically from nginx's X-Forwarded-Proto.
COOKIE_DOMAIN=.primeshelfspace.com

# --- Payment page security policy -------------------------------------------
# Brand logos are served from S3 through signed URLs; the payment page's CSP
# blocks them unless the bucket's origin is listed here.
NEXT_PUBLIC_ASSET_ORIGIN=https://CHANGE-ME-bucket.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_GATEWAY_ORIGIN=
